# Node / Frontend
menulens/frontend/node_modules/
menulens/node_modules/
menulens/frontend/dist/
menulens/frontend/build/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
*.log

# Python / Backend
__pycache__/
**/__pycache__/
*.py[cod]
*.pyo
*.pyd
.Python
.venv/
venv/
menulens/backend/.venv/
menulens/backend/venv/
*.egg-info/
dist/
build/
.eggs/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Environment variables (all of them; commit .env.example instead)
.env
.env.*
!.env.example
menulens/frontend/.env
menulens/frontend/.env.*
!menulens/frontend/.env.example

# Uploaded / generated files
menulens/backend/uploads/
menulens/uploads/

# Docker
*.override.yml

# Database
*.sqlite3
*.db

# OS
.DS_Store
**/.DS_Store
Thumbs.db
desktop.ini

# IDE
.vscode/
.idea/
*.swp
*.swo

# Alembic
menulens/backend/alembic/versions/*.pyc

# Sample menu images used for manual testing.
# NOTE: Images/ is currently tracked on purpose (demo assets). This rule is
# case-correct so a new lowercase images/ scratch folder stays out.
images/

# Docs (keep only README.md)
*.md
!README.md
*.docx

.claude/

# Secrets / credentials — belt and braces on top of the .env rules above
*.pem
*.key
*.p12
*.pfx
id_rsa*
credentials.json
service-account*.json
secrets.y*ml

# Coverage / test output
.coverage
coverage/
htmlcov/
.tox/
.nox/
