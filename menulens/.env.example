# MenuLens backend — copy to .env and fill in. Never commit the real .env.

# Anthropic API key used for menu parsing. https://console.anthropic.com/
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
ANTHROPIC_MODEL=claude-haiku-4-5-20251001

# Signing key for session JWTs. REQUIRED — the app refuses to start without it.
# Generate one with:  python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=

# PostgreSQL connection string. Railway's Postgres plugin provides this in prod.
DATABASE_URL=postgresql://menulens:menulens@localhost:5432/menulens

# Set to "production" in any deployed environment. This is what turns on
# Secure + SameSite=None on the session cookie — leaving it unset in production
# means the session cookie is sent without the Secure flag.
ENVIRONMENT=development

# Origin of the deployed frontend, added to the CORS allowlist.
FRONTEND_URL=https://your-frontend.vercel.app
